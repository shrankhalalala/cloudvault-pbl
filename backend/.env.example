# Python runtime. Copy values into Lambda Console only for cloud deployment.
CLOUDVAULT_MODE=local
CLOUDVAULT_AUTH_MODE=local-token
# Local loopback simulator only. Generate a random token of at least 32 characters.
CLOUDVAULT_LOCAL_TOKEN=
CLOUDVAULT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Cloud mode uses CLOUDVAULT_MODE=aws and CLOUDVAULT_AUTH_MODE=jwt.
# AWS_REGION is automatically supplied by Lambda.
AWS_REGION=
CLOUDVAULT_BUCKET_NAME=
CLOUDVAULT_TABLE_NAME=
CLOUDVAULT_AWS_ACCOUNT_ID=
CLOUDVAULT_OWNER_SUB=
CLOUDVAULT_JWT_ISSUER=
CLOUDVAULT_JWT_CLIENT_ID=
CLOUDVAULT_JWT_SCOPE=cloudvault/workspace
CLOUDVAULT_SNS_TOPIC_ARN=
CLOUDVAULT_NOTIFICATIONS_ENABLED=false
CLOUDVAULT_SUMMARY_ENABLED=false
